OPENROUTER_API_KEY=replace-me
# Required for Gemini Omni, Gemini TTS, and Lyria (audio cooks) — Google AI Studio key
GEMINI_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Agentic Video Pipeline

# Auth (see docs/auth-contract.md). Local default is AUTH_MODE=dev.
AUTH_MODE=dev
DEV_USER_ID=local-dev
AUTOCOOK_JWT_SECRET=dev-insecure-autocook-jwt-secret-change-me
# AUTOCOOK_SERVICE_TOKEN=long-random-shared-with-mother

# Railway / Postgres (when set, runs+jobs live in Postgres for web+worker share)
# DATABASE_URL=postgres://...
