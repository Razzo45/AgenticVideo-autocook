# Railway worker — drains GDP-style job queue; needs ffmpeg + GEMINI_API_KEY.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:22-bookworm-slim AS runner
# ffmpeg for stitch/audio; chromium for HTML→PDF (LibreOffice is too heavy for this image).
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    chromium \
    fonts-liberation \
    fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/ \
  && ffmpeg -version \
  && chromium --version
WORKDIR /app
ENV NODE_ENV=production
ENV SERVICE_ROLE=worker
ENV CHROMIUM_BIN=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./
COPY src ./src
COPY config ./config
COPY sql ./sql
COPY tsconfig.json ./tsconfig.json
RUN npm install tsx --omit=dev --no-save \
  && mkdir -p /app/runs

CMD ["npx", "tsx", "src/worker.ts"]
