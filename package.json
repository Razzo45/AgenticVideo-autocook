{
  "name": "agentic-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev --turbopack -p 3001\" \"tsx src/worker.ts\"",
    "dev:web": "next dev --turbopack -p 3001",
    "worker": "tsx src/worker.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"next start -p 3000\" \"tsx src/worker.ts\"",
    "start:web": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:worker": "tsx src/worker.ts",
    "test": "node tests/run-all.mjs all",
    "test:unit": "node tests/run-all.mjs unit",
    "test:integration": "node tests/run-all.mjs integration",
    "test:e2e": "node tests/run-all.mjs e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@google/genai": "^2.31.0",
    "jszip": "^3.10.2",
    "next": "^15.5.2",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "railway": "^3.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
